{
  "name": "dsh-archived-sessions",
  "version": "0.2.0",
  "description": "DSH web plugin: an Archived Sessions manager in Settings — browse archived conversations, expand per-session details (disk usage, downloads, tool usage, lineage, cross-session recall), multi-select and permanently delete.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "Zephyr-vibe (original work), AkotaP (fork)",
  "contributors": [
    "Zephyr-vibe <719569019@qq.com> (upstream author)"
  ],
  "homepage": "https://github.com/AkotaP/dsh-archived-sessions#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AkotaP/dsh-archived-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/AkotaP/dsh-archived-sessions/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "package.json"
  ]
}
